# Required. The library API key. Never commit a real value.
LIBRARY_API_KEY=
# Optional. Defaults shown.
LIBRARY_API_URL=https://library-prod.webuddhist.com
LIBRARY_APP_NAME=webuddhist
LIBRARY_PREFERRED_LANGUAGES=en,bo
LIBRARY_TIMEOUT_MS=30000
# HTTP entrypoint only (bin/http.ts): inbound bearer token clients must present.
MCP_BEARER_TOKEN=
MCP_HTTP_PORT=3000
