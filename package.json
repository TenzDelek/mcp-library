{
  "name": "buddhist-creator-connector",
  "version": "0.2.0",
  "private": true,
  "description": "Source hub for the Buddhist Creator Connector: skills, MCP server, generated per-store wrappers and the optimization loop",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "wrappers/dsh-bundle"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "pretest": "tsc -b",
    "test": "vitest run",
    "test:live": "npm run test:live -w packages/connector-server",
    "generate": "tsx scripts/generate-wrappers.ts",
    "generate:check": "tsx scripts/generate-wrappers.ts --check",
    "verify": "npm run generate:check && npm run validate:plugin",
    "validate:plugin": "claude plugin validate . || echo 'claude CLI not available; skipped'",
    "check": "npm run check -w packages/connector-server",
    "dev": "npm run dev -w packages/connector-server",
    "dev:remote": "npm run dev -w apps/remote",
    "record-fixtures": "npm run record-fixtures -w packages/library-client",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env packages/connector-server/dist/bin/stdio.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
